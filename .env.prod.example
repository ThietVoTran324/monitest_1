# ========================
# Runtime mode (prod)
# ========================
# Ports: API loopback 127.0.0.1:8010 (+ frontend 4173) behind Caddy on pinvps01.
# Do NOT point GitHub VPS_HOST at pinvps01 until smoke-on-host (Moni_Sprint0).
# Modes SSOT: docs/Planing_docs/moni/RUNTIME_MODES.md
APP_ENV=production
APP_BASE_URL=https://monitoring1.io.vn
API_PUBLIC_URL=https://monitoring1.io.vn

# ========================
# Database (kept same shape)
# ========================
POSTGRES_USER=moni
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=moni
DATABASE_URL=postgresql+asyncpg://moni:change_me_db_password@postgres:5432/moni

# ========================
# Redis/Celery (kept same shape)
# ========================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ========================
# Auth/JWT (must change)
# ========================
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=14

# ========================
# SMTP (keep provider if already working)
# ========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@example.com

# ========================
# OAuth (must match monitoring1.io.vn)
# ========================
GOOGLE_OAUTH_CLIENT_ID=replace_me
GOOGLE_OAUTH_CLIENT_SECRET=replace_me
GOOGLE_OAUTH_REDIRECT_URI=https://monitoring1.io.vn/api/v1/auth/google/callback

EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=48
ALERT_COOLDOWN_MINUTES=10
ALERT_STILL_DOWN_REMINDER_MINUTES=30
ALERT_MAX_REMINDERS_PER_INCIDENT=24
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OUTBOX_BACKOFF_SECONDS=60,300,900
EMAIL_OUTBOX_BATCH_SIZE=20
RUN_CHECK_MIN_INTERVAL_SECONDS=15
RUNTIME_BEAT_STALE_SECONDS=120

# Celery queue fairness (Redis)
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_DISABLE_PREFETCH=true
CELERY_TASK_ACKS_LATE=true

# Probe / SSRF
SSRF_MAX_REDIRECTS=5
SSRF_MAX_RESPONSE_BYTES=5242880

# Freshness
MONITOR_STALE_FACTOR=2.0
MONITOR_STALE_MIN_BUFFER_SECONDS=60

# Rate limits
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
PUBLIC_STATUS_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_STATUS_RATE_LIMIT_MAX_ATTEMPTS=60

# ========================
# Image tags — prefer /opt/moni/.env.images (see .env.images.example).
# CI deploy writes .env.images and does not sed this secrets file.
# Keep placeholders here only for first manual bring-up if needed:
# ========================
# BACKEND_IMAGE=ghcr.io/your-org-or-user/moni-backend:latest
# FRONTEND_IMAGE=ghcr.io/your-org-or-user/moni-frontend:latest
