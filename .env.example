# Copy: cp .env.example .env rồi điền secret (file .env không commit)
# Runtime modes / ports: docs/Planing_docs/moni/RUNTIME_MODES.md
# local-process (default): API http://127.0.0.1:8011
# local-docker / prod loopback: API http://127.0.0.1:8010

# APP_ENV=development
APP_BASE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8011

# Khớp: user/db moni @ localhost:5432 — tạo bằng SQL trong ENV-CONVENTIONS.md
# Hoặc: docker compose up -d postgres redis
DATABASE_URL=postgresql+asyncpg://moni:moni_local_dev@localhost:5432/moni
# Beat không có biến riêng; cùng broker với worker.
# Local: redis://localhost:6379/0 | Redis Cloud: redis://default:PASSWORD@HOST:PORT/0 (hoặc rediss:// nếu bắt buộc TLS)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

JWT_SECRET=
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=14

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8011/api/v1/auth/google/callback

EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=48
ALERT_COOLDOWN_MINUTES=10
ALERT_STILL_DOWN_REMINDER_MINUTES=30
ALERT_MAX_REMINDERS_PER_INCIDENT=24
# Email outbox (global; admin can override per monitor)
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OUTBOX_BACKOFF_SECONDS=60,300,900
EMAIL_OUTBOX_BATCH_SIZE=20
RUN_CHECK_MIN_INTERVAL_SECONDS=15
RUNTIME_BEAT_STALE_SECONDS=120

# Celery queue fairness (Redis)
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_DISABLE_PREFETCH=true
CELERY_TASK_ACKS_LATE=true

# Probe / SSRF (tunable)
SSRF_MAX_REDIRECTS=5
# Bytes read into memory per check (default 5 MiB). Raise for heavy pages; lower to save RAM.
SSRF_MAX_RESPONSE_BYTES=5242880

# Monitor freshness badge (stale if age > interval*factor + buffer)
MONITOR_STALE_FACTOR=2.0
MONITOR_STALE_MIN_BUFFER_SECONDS=60

# Rate limits
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
PUBLIC_STATUS_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_STATUS_RATE_LIMIT_MAX_ATTEMPTS=60
